rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ 輔助函式 ============
    function isSignedIn() {
      return request.auth != null;
    }

    // 取得目前登入者的 users 文件資料
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && currentUser().role == 'admin';
    }

    function isStaff() {
      return isSignedIn() && (currentUser().role == 'admin' || currentUser().role == 'service');
    }

    // 課程是否已「發佈展示連結」：
    //   管理員開啟展示頁（open.html?c=）時會寫入 openShareToken 與 openShareActive
    //   關閉「設定 → 連結」開關時會將 openShareActive 設為 false（立即撤銷免登入讀取）
    function openPublished(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.get('openShareActive', false) == true;
    }

    // ============ users 集合 ============
    // 欄位：uid, name, email, phone, unit, role, createdAt, updatedAt
    match /users/{userId} {
      // 讀取：本人可讀自己；服務/管理員可讀全部；
      //      分享頁 share.html（免登入）僅可讀取「學員」文件（role == 'student'）
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff())
        || (resource.data.role == 'student');

      // 建立：本人建立自己的文件（註冊，任一角色）；管理員可建立任意
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.uid ||
        isAdmin()
      );

      // 更新：本人可更新自己（但不可改 role）；管理員可更新全部
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );

      // 刪除：僅管理員
      allow delete: if isAdmin();
    }

    // ============ checkins 集合（報到紀錄） ============
    // 欄位：uid, name, scannedBy, scannedByName, checkedInAt
    match /checkins/{checkinId} {
      // 讀取：學員讀自己的；服務/管理員讀全部；展示頁免登入讀取（課程已發佈）
      allow read: if (isSignedIn() && (resource.data.uid == request.auth.uid || isStaff()))
        || (resource.data.courseId is string && openPublished(resource.data.courseId));

      // 建立：僅服務/管理員（掃描報到）
      allow create: if isStaff();

      // 修改：服務/管理員可取消報到；學員僅能補上「簽名」欄位（限自己的紀錄、僅限簽名欄位）
      allow update: if isStaff()
        || (isSignedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signature', 'signedAt']));

      // 刪除：服務/管理員（取消報到）
      allow delete: if isStaff();
    }

    // ============ courseFiles 集合（課程檔案） ============
    // 欄位：courseId, tabId, name, ext, size, contentType, chunkCount, allowDownload
    match /courseFiles/{fileId} {
      // 讀取：所有登入者（學員端需瀏覽與預覽）；展示頁免登入讀取（課程已發佈）
      allow read: if isSignedIn()
        || (resource.data.courseId is string && openPublished(resource.data.courseId));

      // 建立 / 修改 / 刪除：僅服務 / 管理員
      allow create, update, delete: if isStaff();

      // 檔案內容：Base64 分塊（不用 Storage）
      match /chunks/{chunkId} {
        allow read: if isSignedIn()
          || openPublished(get(/databases/$(database)/documents/courseFiles/$(fileId)).data.courseId);
        allow write: if isStaff();
      }
    }

    // ============ settings 集合（系統設定） ============
    // 文件：settings/system
    match /settings/{docId} {
      // 讀取：所有登入者
      allow read: if isSignedIn();

      // 寫入：僅服務/管理員
      allow write: if isStaff();
    }

    // ============ courses 集合（課程） ============
    // 欄位：name, instructor, date, location, notes, seat, seatAssignments, seatSelfPicks, createdAt, updatedAt
    match /courses/{courseId} {
      // 讀取：所有人（登入者、展示頁，以及分享頁 share.html 的課程切換皆可讀取）
      allow read: if true;

      // 寫入：僅服務/管理員
      allow create, update, delete: if isStaff();

      // 學員自選座位：僅在課程開啟 seat.allowSelfSelect 時，允許學員新增/變更/移除「自己的」自選座位
      // seatSelfPicks 以 uid 為鍵（uid -> 座位代號），故規則可限制僅能改動自身鍵值
      allow update: if isSignedIn()
        && resource.data.get('seat', {}).get('allowSelfSelect', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seatSelfPicks'])
        && request.resource.data.get('seatSelfPicks', {}).diff(resource.data.get('seatSelfPicks', {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    // ============ instructors 集合（講師） ============
    // 欄位：name, specialty, phone, email, createdAt, updatedAt
    match /instructors/{instructorId} {
      // 讀取：所有登入者
      allow read: if isSignedIn();

      // 寫入：僅服務/管理員
      allow create, update, delete: if isStaff();
    }

    // ============ regions 集合（區域） ============
    // 欄位：city, district, createdAt, updatedAt
    match /regions/{regionId} {
      // 讀取：所有登入者
      allow read: if isSignedIn();

      // 寫入：僅服務/管理員
      allow create, update, delete: if isStaff();
    }

    // ============ communities 集合（社區） ============
    // 欄位：code, name, createdAt, updatedAt
    match /communities/{communityId} {
      // 讀取：所有人（含分享頁 share.html 免登入）
      allow read: if true;

      // 寫入：僅服務/管理員
      allow create, update, delete: if isStaff();
    }

    // ============ titles 集合（職稱） ============
    // 欄位：name, createdAt, updatedAt
    match /titles/{titleId} {
      // 讀取：所有登入者
      allow read: if isSignedIn();

      // 寫入：僅服務/管理員
      allow create, update, delete: if isStaff();
    }

    // ============ units 集合（單位） ============
    // 欄位：name, createdAt, updatedAt
    match /units/{unitId} {
      // 讀取：所有人（含分享頁 share.html 免登入）
      allow read: if true;

      // 寫入：僅服務/管理員
      allow create, update, delete: if isStaff();
    }

    // ============ courseActivities 集合（活動主題） ============
    // 欄位：courseId, title, image, links[], order, createdAt, updatedAt
    match /courseActivities/{activityId} {
      // 讀取：所有登入者（學員端需瀏覽活動）；展示頁免登入讀取（課程已發佈）
      allow read: if isSignedIn()
        || (resource.data.courseId is string && openPublished(resource.data.courseId));

      // 寫入：僅服務/管理員
      allow create, update, delete: if isStaff();
    }

    // ============ voteResponses 集合（投票紀錄） ============
    // 欄位：courseId, voteId, uid, name, optionIds, createdAt, updatedAt
    match /voteResponses/{responseId} {
      // 讀取：所有登入者（學員端顯示即時結果）；展示頁免登入讀取（課程已發佈）
      allow read: if isSignedIn()
        || (resource.data.courseId is string && openPublished(resource.data.courseId));

      // 建立/修改：學員僅能寫入自己的投票（uid 需與登入者一致）
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;

      // 刪除：僅服務/管理員
      allow delete: if isStaff();
    }

    // ============ examResults 集合（測驗成績） ============
    // 欄位：courseId, uid, name, community, title, score, total, percent, passed, attempts
    match /examResults/{resultId} {
      // 讀取：所有登入者（學員讀自己的成績；服務/管理員查看通過名單）；展示頁免登入讀取（課程已發佈）
      allow read: if isSignedIn()
        || (resource.data.courseId is string && openPublished(resource.data.courseId));

      // 建立/修改：學員僅能寫入自己的成績（uid 需與登入者一致）
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;

      // 刪除：僅服務/管理員
      allow delete: if isStaff();
    }

    // ============ certs 集合（服務端發送的課程合格證書） ============
    // 欄位：courseId, courseName, uid, name, community, title, unit, issuedAt, issuedBy
    match /certs/{certId} {
      // 讀取：所有登入者（學員讀自己的證書；服務/管理員查看全部）
      allow read: if isSignedIn();

      // 建立 / 修改 / 刪除：僅服務/管理員（發送 / 收回）
      allow create, update, delete: if isStaff();
    }

    // ============ buzzRounds 集合（搶答紀錄） ============
    // 欄位：courseId, round, uid, name, buzzedAt
    match /buzzRounds/{roundId} {
      // 讀取：所有登入者；展示頁免登入讀取（課程已發佈）
      allow read: if isSignedIn()
        || (resource.data.courseId is string && openPublished(resource.data.courseId));

      // 建立：學員搶答（uid 需與登入者一致）
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;

      // 修改/刪除：僅服務/管理員（清除紀錄）
      allow update, delete: if isStaff();
    }

    // ============ parkingShares 集合（停車資訊分享頁） ============
    // 欄位：courseId, courseName, courseDate, courseTime, items[], updatedAt
    // 文件 ID 為隨機 token（不可猜測），供「停車資訊」分享頁免登入檢視
    match /parkingShares/{token} {
      // 讀取：免登入（分享連結持有者）
      allow read: if true;

      // 寫入：僅服務/管理員
      allow create, update, delete: if isStaff();
    }

    // ============ openShares 集合（課程展示頁分享對照） ============
    // 欄位：courseId, courseName, enabled, tab, recent, updatedAt
    // 文件 ID 為隨機 token（不可猜測），供展示頁 open.html?s=<token> 免登入解析課程
    match /openShares/{token} {
      // 讀取：免登入（展示連結持有者）
      allow read: if true;

      // 建立 / 刪除：僅服務/管理員
      allow create, delete: if isStaff();

      // 更新：服務/管理員可完整管理；
      // 持有 token 的展示頁（免登入）僅能更新「顯示狀態」欄位（tab / recent）以實現跨裝置遙控同步
      allow update: if isStaff()
        || (resource.data.get('enabled', false) == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tab', 'recent', 'updatedAt']));
    }
  }
}
